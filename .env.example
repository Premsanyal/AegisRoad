# AegisRoad Environment Variables
# Copy to .env and fill in values

# Database
DB_PASSWORD=aegisroad_dev

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# TomTom API (free tier: 2500 req/day)
TOMTOM_API_KEY=your_tomtom_api_key

# HERE API (free tier: 250000 req/mo)
HERE_API_KEY=your_here_api_key
HERE_API_SECRET=your_here_api_secret

# Mapbox (optional, for satellite imagery)
MAPBOX_TOKEN=your_mapbox_token

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Sentry (error tracking)
SENTRY_DSN=your_sentry_dsn

# Grafana Cloud (observability)
GRAFANA_CLOUD_API_KEY=your_grafana_key
GRAFANA_CLOUD_PROMETHEUS_URL=your_prometheus_url
GRAFANA_CLOUD_LOKI_URL=your_loki_url
GRAFANA_CLOUD_TEMPO_URL=your_tempo_url

# GitHub Container Registry
GHCR_TOKEN=your_ghcr_token

# Kubernetes
KUBECONFIG_DEV=~/.kube/config-dev
KUBECONFIG_PROD=~/.kube/config-prod